{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/agent-.log", "rollingInterval": "Day" }
      }
    ]
  },
  "AgentSettings": {
    "ApiKey": "agent-key-linux-01",
    "AllowedShells": [ "bash", "powershell", "cmd" ],
    "CommandTimeoutSeconds": 60,
    "MaxOutputBytes": 65536,
    "BlacklistedCommands": [
      "rm -rf /",
      "format c:",
      "del /f /s /q c:\\",
      "shutdown",
      "reboot"
    ]
  },
  "Urls": "http://0.0.0.0:5001",
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
